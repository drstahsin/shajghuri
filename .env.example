# Required in every environment. Use a unique password with at least 14 characters.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Required for signed, httpOnly admin sessions. Use 32+ random characters.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Required on Vercel. Add a pooled PostgreSQL connection string from the Vercel Marketplace.
DATABASE_URL=

# Optional: SMTP settings for order receipts and contact inquiries.
EMAIL_USER=
EMAIL_APP_PASSWORD=
